        [ a owl:Restriction ; owl:onProperty sc:billofmaterialsline_bomLineId ; owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:billofmaterialsline_bomId ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:billofmaterialsline_partId ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:billofmaterialsline_quantityPer ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:billofmaterialsline_findNumber ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

sc:billofmaterialsline_bomLineId a owl:DatatypeProperty ;
    rdfs:label "BOM_LINE_ID" ;
    rdfs:comment "BOM_LINE.BOM_LINE_ID" ;
    rdfs:domain sc:BillOfMaterialsLine ;
    rdfs:range xsd:integer .

sc:billofmaterialsline_bomId a owl:ObjectProperty ;
    rdfs:label "line of BOM" ;
    rdfs:comment "Bill of materials this line belongs to" ;
    rdfs:domain sc:BillOfMaterialsLine ;
    rdfs:range sc:BillOfMaterials ;
    coa:fkProvenance "MANY_TO_ONE" .

sc:billofmaterialsline_partId a owl:ObjectProperty ;
    rdfs:label "consumes part" ;
    rdfs:comment "Component part consumed by this BOM position" ;
    rdfs:domain sc:BillOfMaterialsLine ;
    rdfs:range sc:Part ;
    coa:fkProvenance "MANY_TO_ONE" .

sc:billofmaterialsline_quantityPer a owl:DatatypeProperty ;
    rdfs:label "QUANTITY_PER" ;
    rdfs:comment "BOM_LINE.QUANTITY_PER" ;
    rdfs:domain sc:BillOfMaterialsLine ;
    skos:altLabel "qty per" ;
    skos:altLabel "usage per assembly" ;
    skos:altLabel "quantity per assembly" ;
    rdfs:range xsd:decimal .

sc:billofmaterialsline_findNumber a owl:DatatypeProperty ;
    rdfs:label "FIND_NUMBER" ;
    rdfs:comment "Position on the BOM" ;
    rdfs:domain sc:BillOfMaterialsLine ;
    rdfs:range xsd:integer .

