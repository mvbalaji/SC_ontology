    rdfs:comment "DIM_CUSTOMER.CUSTOMER_CODE" ;
    rdfs:domain sc:Customer ;
    rdfs:range xsd:string .

sc:customer_countryId a owl:ObjectProperty ;
    rdfs:label "countryId" ;
    rdfs:comment "Foreign key: DIM_CUSTOMER.COUNTRY_ID references DIM_GEO_COUNTRY.COUNTRY_ID" ;
    rdfs:domain sc:Customer ;
    rdfs:range sc:Country ;
    coa:fkProvenance "MANY_TO_ONE" .

sc:customer_customerTier a owl:DatatypeProperty ;
    rdfs:label "CUSTOMER_TIER" ;
    rdfs:comment "PLATINUM, GOLD, SILVER, BRONZE" ;
    rdfs:domain sc:Customer ;
    skos:altLabel "tier" ;
    skos:altLabel "segment" ;
    skos:altLabel "customer segment" ;
    coa:distinctValues "BRONZE" ;
    coa:distinctValues "GOLD" ;
    coa:distinctValues "PLATINUM" ;
    coa:distinctValues "SILVER" ;
    rdfs:range xsd:string .

sc:customer_isSynthetic a owl:DatatypeProperty ;
    rdfs:label "IS_SYNTHETIC" ;
    rdfs:comment "DIM_CUSTOMER.IS_SYNTHETIC" ;
    rdfs:domain sc:Customer ;
    rdfs:range xsd:boolean .

#----------------------------------------------------------------------------
# Carrier  <-  SCS.INVENTORY.DIM_CARRIER
#----------------------------------------------------------------------------

sc:Carrier a owl:Class ;
    rdfs:label "Carrier" ;
    rdfs:comment "Logistics carriers" ;
    skos:altLabel "freight forwarder" ;
    skos:altLabel "shipping line" ;
    skos:altLabel "DIM_CARRIER" ;
    skos:altLabel "logistics provider" ;
