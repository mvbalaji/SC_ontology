sc:purchaseorderline_promiseDate a owl:DatatypeProperty ;
    rdfs:label "PROMISE_DATE" ;
    rdfs:comment "Original supplier promise date" ;
    rdfs:domain sc:PurchaseOrderLine ;
    rdfs:range xsd:date .

#----------------------------------------------------------------------------
# GoodsReceipt  <-  SCS.INVENTORY.GOODS_RECEIPT
#----------------------------------------------------------------------------

sc:GoodsReceipt a owl:Class ;
    rdfs:label "Goods Receipt" ;
    rdfs:comment "Goods receipts — 90,000 receipts against PO lines" ;
    skos:altLabel "grn" ;
    skos:altLabel "receipt" ;
    skos:altLabel "goods received note" ;
    skos:altLabel "GOODS_RECEIPT" ;
    skos:altLabel "delivery" ;
    owl:hasKey ( sc:goodsreceipt_receiptId ) ;
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty sc:goodsreceipt_receiptId ; owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:goodsreceipt_poLineId ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:goodsreceipt_receiptDate ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:goodsreceipt_quantityReceived ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:goodsreceipt_warehouseId ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:goodsreceipt_daysVariance ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

sc:goodsreceipt_receiptId a owl:DatatypeProperty ;
    rdfs:label "RECEIPT_ID" ;
    rdfs:comment "GOODS_RECEIPT.RECEIPT_ID" ;
    rdfs:domain sc:GoodsReceipt ;
    rdfs:range xsd:integer .

sc:goodsreceipt_poLineId a owl:ObjectProperty ;
    rdfs:label "receipt against PO line" ;
    rdfs:comment "Purchase order line this receipt fulfils" ;
    rdfs:domain sc:GoodsReceipt ;
    rdfs:range sc:PurchaseOrderLine ;
    coa:fkProvenance "MANY_TO_ONE" .

sc:goodsreceipt_receiptDate a owl:DatatypeProperty ;
    rdfs:label "RECEIPT_DATE" ;
    rdfs:comment "Actual physical receipt date" ;
    rdfs:domain sc:GoodsReceipt ;
    rdfs:range xsd:date .

sc:goodsreceipt_quantityReceived a owl:DatatypeProperty ;
    rdfs:label "QUANTITY_RECEIVED" ;
    rdfs:comment "GOODS_RECEIPT.QUANTITY_RECEIVED" ;
    rdfs:domain sc:GoodsReceipt ;
    rdfs:range xsd:decimal .

sc:goodsreceipt_warehouseId a owl:ObjectProperty ;
    rdfs:label "received into warehouse" ;
    rdfs:comment "Warehouse the goods were received into" ;
    rdfs:domain sc:GoodsReceipt ;
    rdfs:range sc:Warehouse ;
    coa:fkProvenance "MANY_TO_ONE" .

sc:goodsreceipt_daysVariance a owl:DatatypeProperty ;
    rdfs:label "DAYS_VARIANCE" ;
    rdfs:comment "Days early (negative) or late (positive) vs promise date" ;
    rdfs:domain sc:GoodsReceipt ;
    skos:altLabel "delivery variance" ;
    skos:altLabel "days late" ;
    skos:altLabel "schedule variance" ;
    skos:altLabel "otd variance" ;
    rdfs:range xsd:integer .

