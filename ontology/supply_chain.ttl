        [ a owl:Restriction ; owl:onProperty sc:purchaseorder_supplierId ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:purchaseorder_plantId ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
