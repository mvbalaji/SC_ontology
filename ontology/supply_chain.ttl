sc:Country a owl:Class ;
    rdfs:label "Country" ;
    rdfs:comment "Countries mapped to regions" ;
    skos:altLabel "nation" ;
    skos:altLabel "DIM_GEO_COUNTRY" ;
    skos:altLabel "country of origin" ;
    owl:hasKey ( sc:country_countryId ) ;
    rdfs:subClassOf
