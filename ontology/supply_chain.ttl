        [ a owl:Restriction ; owl:onProperty sc:salesorderline_orderLineId ; owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:salesorderline_orderId ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:salesorderline_productId ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:salesorderline_quantity ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:salesorderline_unitPrice ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:salesorderline_requestedDate ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

sc:salesorderline_orderLineId a owl:DatatypeProperty ;
    rdfs:label "ORDER_LINE_ID" ;
    rdfs:comment "SALES_ORDER_LINE.ORDER_LINE_ID" ;
    rdfs:domain sc:SalesOrderLine ;
    rdfs:range xsd:integer .

sc:salesorderline_orderId a owl:ObjectProperty ;
    rdfs:label "orderId" ;
    rdfs:comment "Foreign key: SALES_ORDER_LINE.ORDER_ID references SALES_ORDER_HEADER.ORDER_ID" ;
    rdfs:domain sc:SalesOrderLine ;
    rdfs:range sc:SalesOrder ;
    coa:fkProvenance "MANY_TO_ONE" .

sc:salesorderline_productId a owl:ObjectProperty ;
    rdfs:label "sells product" ;
    rdfs:comment "Finished product being sold on this line" ;
    rdfs:domain sc:SalesOrderLine ;
    rdfs:range sc:Product ;
    coa:fkProvenance "MANY_TO_ONE" .

sc:salesorderline_quantity a owl:DatatypeProperty ;
    rdfs:label "QUANTITY" ;
    rdfs:comment "SALES_ORDER_LINE.QUANTITY" ;
    rdfs:domain sc:SalesOrderLine ;
    rdfs:range xsd:decimal .

sc:salesorderline_unitPrice a owl:DatatypeProperty ;
    rdfs:label "UNIT_PRICE" ;
    rdfs:comment "SALES_ORDER_LINE.UNIT_PRICE" ;
    rdfs:domain sc:SalesOrderLine ;
    rdfs:range xsd:decimal .

sc:salesorderline_requestedDate a owl:DatatypeProperty ;
    rdfs:label "REQUESTED_DATE" ;
    rdfs:comment "SALES_ORDER_LINE.REQUESTED_DATE" ;
    rdfs:domain sc:SalesOrderLine ;
    rdfs:range xsd:date .

#----------------------------------------------------------------------------
# Shipment  <-  SCS.INVENTORY.SHIPMENT_HEADER
#----------------------------------------------------------------------------

sc:Shipment a owl:Class ;
    rdfs:label "Shipment" ;
    rdfs:comment "Shipment headers — 18,000 shipments" ;
    skos:altLabel "freight" ;
    skos:altLabel "consignment" ;
    skos:altLabel "SHIPMENT_HEADER" ;
    skos:altLabel "load" ;
    owl:hasKey ( sc:shipment_shipmentId ) ;
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty sc:shipment_shipmentId ; owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:shipment_carrierId ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:shipment_laneId ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:shipment_shipDate ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:shipment_status ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

sc:shipment_shipmentId a owl:DatatypeProperty ;
    rdfs:label "SHIPMENT_ID" ;
    rdfs:comment "SHIPMENT_HEADER.SHIPMENT_ID" ;
    rdfs:domain sc:Shipment ;
    rdfs:range xsd:integer .

sc:shipment_carrierId a owl:ObjectProperty ;
    rdfs:label "shipped by carrier" ;
    rdfs:comment "Carrier moving the shipment" ;
    rdfs:domain sc:Shipment ;
    rdfs:range sc:Carrier ;
    coa:fkProvenance "MANY_TO_ONE" .

sc:shipment_laneId a owl:ObjectProperty ;
    rdfs:label "travels lane" ;
    rdfs:comment "Shipping lane the shipment moves on" ;
    rdfs:domain sc:Shipment ;
    rdfs:range sc:Lane ;
    coa:fkProvenance "MANY_TO_ONE" .

sc:shipment_shipDate a owl:DatatypeProperty ;
    rdfs:label "SHIP_DATE" ;
    rdfs:comment "SHIPMENT_HEADER.SHIP_DATE" ;
    rdfs:domain sc:Shipment ;
    rdfs:range xsd:date .

sc:shipment_deliveryDate a owl:DatatypeProperty ;
    rdfs:label "DELIVERY_DATE" ;
    rdfs:comment "SHIPMENT_HEADER.DELIVERY_DATE" ;
    rdfs:domain sc:Shipment ;
    rdfs:range xsd:date .

sc:shipment_status a owl:DatatypeProperty ;
    rdfs:label "STATUS" ;
    rdfs:comment "SHIPMENT_HEADER.STATUS" ;
    rdfs:domain sc:Shipment ;
    coa:distinctValues "DELAYED" ;
    coa:distinctValues "DELIVERED" ;
    coa:distinctValues "IN_TRANSIT" ;
    rdfs:range xsd:string .

#----------------------------------------------------------------------------
# ShipmentLine  <-  SCS.INVENTORY.SHIPMENT_LINE
#----------------------------------------------------------------------------

sc:ShipmentLine a owl:Class ;
    rdfs:label "Shipment Line" ;
    rdfs:comment "Shipment line items linking to orders or POs" ;
    skos:altLabel "shipment item" ;
    skos:altLabel "SHIPMENT_LINE" ;
    owl:hasKey ( sc:shipmentline_shipmentLineId ) ;
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty sc:shipmentline_shipmentLineId ; owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:shipmentline_shipmentId ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:shipmentline_quantity ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

sc:shipmentline_shipmentLineId a owl:DatatypeProperty ;
    rdfs:label "SHIPMENT_LINE_ID" ;
    rdfs:comment "SHIPMENT_LINE.SHIPMENT_LINE_ID" ;
    rdfs:domain sc:ShipmentLine ;
    rdfs:range xsd:integer .

sc:shipmentline_shipmentId a owl:ObjectProperty ;
    rdfs:label "shipmentId" ;
    rdfs:comment "Foreign key: SHIPMENT_LINE.SHIPMENT_ID references SHIPMENT_HEADER.SHIPMENT_ID" ;
    rdfs:domain sc:ShipmentLine ;
    rdfs:range sc:Shipment ;
    coa:fkProvenance "MANY_TO_ONE" .

sc:shipmentline_orderLineId a owl:ObjectProperty ;
    rdfs:label "fulfils sales order line" ;
    rdfs:comment "Sales order line this shipment line fulfils; null for inbound freight" ;
    rdfs:domain sc:ShipmentLine ;
    rdfs:range sc:SalesOrderLine ;
    coa:fkProvenance "MANY_TO_ONE" .

sc:shipmentline_poLineId a owl:ObjectProperty ;
    rdfs:label "fulfils purchase order line" ;
    rdfs:comment "Purchase order line this shipment line fulfils; null for outbound freight" ;
    rdfs:domain sc:ShipmentLine ;
    rdfs:range sc:PurchaseOrderLine ;
    coa:fkProvenance "MANY_TO_ONE" .

sc:shipmentline_quantity a owl:DatatypeProperty ;
    rdfs:label "QUANTITY" ;
    rdfs:comment "SHIPMENT_LINE.QUANTITY" ;
    rdfs:domain sc:ShipmentLine ;
    rdfs:range xsd:decimal .

#----------------------------------------------------------------------------
# ShipmentMilestoneEvent  <-  SCS.INVENTORY.SHIPMENT_MILESTONE_EVENT
#----------------------------------------------------------------------------

sc:ShipmentMilestoneEvent a owl:Class ;
    rdfs:label "Shipment Milestone Event" ;
    rdfs:comment "Shipment tracking milestones — 250,000 events" ;
    skos:altLabel "tracking event" ;
    skos:altLabel "milestone" ;
    skos:altLabel "shipment status event" ;
    skos:altLabel "SHIPMENT_MILESTONE_EVENT" ;
    owl:hasKey ( sc:shipmentmilestoneevent_eventId ) ;
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty sc:shipmentmilestoneevent_eventId ; owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:shipmentmilestoneevent_shipmentId ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:shipmentmilestoneevent_milestone ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:shipmentmilestoneevent_eventTs ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

sc:shipmentmilestoneevent_eventId a owl:DatatypeProperty ;
    rdfs:label "EVENT_ID" ;
    rdfs:comment "SHIPMENT_MILESTONE_EVENT.EVENT_ID" ;
    rdfs:domain sc:ShipmentMilestoneEvent ;
    rdfs:range xsd:integer .

sc:shipmentmilestoneevent_shipmentId a owl:ObjectProperty ;
    rdfs:label "milestone of shipment" ;
    rdfs:comment "Shipment this tracking milestone belongs to" ;
    rdfs:domain sc:ShipmentMilestoneEvent ;
    rdfs:range sc:Shipment ;
    coa:fkProvenance "MANY_TO_ONE" .

sc:shipmentmilestoneevent_milestone a owl:DatatypeProperty ;
    rdfs:label "MILESTONE" ;
    rdfs:comment "SHIPMENT_MILESTONE_EVENT.MILESTONE" ;
    rdfs:domain sc:ShipmentMilestoneEvent ;
    coa:distinctValues "ARRIVED_PORT" ;
    coa:distinctValues "BOOKING_CONFIRMED" ;
    coa:distinctValues "CUSTOMS_CLEARANCE" ;
    coa:distinctValues "DELIVERED" ;
    coa:distinctValues "DEPARTED" ;
    coa:distinctValues "GATE_IN" ;
    coa:distinctValues "GATE_OUT" ;
    coa:distinctValues "INVOICE_SENT" ;
    coa:distinctValues "IN_TRANSIT" ;
    coa:distinctValues "LOADED" ;
    coa:distinctValues "OUT_FOR_DELIVERY" ;
    coa:distinctValues "PICKED_UP" ;
    coa:distinctValues "POD_SIGNED" ;
    coa:distinctValues "TRANSSHIPMENT" ;
    rdfs:range xsd:string .

sc:shipmentmilestoneevent_eventTs a owl:DatatypeProperty ;
    rdfs:label "EVENT_TS" ;
    rdfs:comment "SHIPMENT_MILESTONE_EVENT.EVENT_TS" ;
    rdfs:domain sc:ShipmentMilestoneEvent ;
    rdfs:range xsd:dateTime .

sc:shipmentmilestoneevent_location a owl:DatatypeProperty ;
    rdfs:label "LOCATION" ;
    rdfs:comment "SHIPMENT_MILESTONE_EVENT.LOCATION" ;
    rdfs:domain sc:ShipmentMilestoneEvent ;
    rdfs:range xsd:string .

#----------------------------------------------------------------------------
# SensorReading  <-  SCS.INVENTORY.IOT_SENSOR_READING
#----------------------------------------------------------------------------

sc:SensorReading a owl:Class ;
    rdfs:label "Sensor Reading" ;
    rdfs:comment "IoT container sensor readings — 500,000 rows, ~1.5% breach rate" ;
    skos:altLabel "iot reading" ;
    skos:altLabel "telemetry" ;
    skos:altLabel "container sensor" ;
    skos:altLabel "IOT_SENSOR_READING" ;
    skos:altLabel "cold chain reading" ;
    owl:hasKey ( sc:sensorreading_readingId ) ;
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty sc:sensorreading_readingId ; owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:sensorreading_shipmentId ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:sensorreading_readingTs ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:sensorreading_breachFlag ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

sc:sensorreading_readingId a owl:DatatypeProperty ;
    rdfs:label "READING_ID" ;
    rdfs:comment "IOT_SENSOR_READING.READING_ID" ;
    rdfs:domain sc:SensorReading ;
    rdfs:range xsd:integer .

sc:sensorreading_shipmentId a owl:ObjectProperty ;
    rdfs:label "reading for shipment" ;
    rdfs:comment "Shipment the sensor reading was captured on" ;
    rdfs:domain sc:SensorReading ;
    rdfs:range sc:Shipment ;
    coa:fkProvenance "MANY_TO_ONE" .

sc:sensorreading_readingTs a owl:DatatypeProperty ;
    rdfs:label "READING_TS" ;
    rdfs:comment "IOT_SENSOR_READING.READING_TS" ;
    rdfs:domain sc:SensorReading ;
    rdfs:range xsd:dateTime .

sc:sensorreading_temperatureC a owl:DatatypeProperty ;
    rdfs:label "TEMPERATURE_C" ;
    rdfs:comment "IOT_SENSOR_READING.TEMPERATURE_C" ;
    rdfs:domain sc:SensorReading ;
    skos:altLabel "temperature" ;
    skos:altLabel "temp" ;
    rdfs:range xsd:decimal .

sc:sensorreading_humidityPct a owl:DatatypeProperty ;
    rdfs:label "HUMIDITY_PCT" ;
    rdfs:comment "IOT_SENSOR_READING.HUMIDITY_PCT" ;
    rdfs:domain sc:SensorReading ;
    rdfs:range xsd:decimal .

sc:sensorreading_shockG a owl:DatatypeProperty ;
    rdfs:label "SHOCK_G" ;
    rdfs:comment "IOT_SENSOR_READING.SHOCK_G" ;
    rdfs:domain sc:SensorReading ;
    rdfs:range xsd:decimal .

sc:sensorreading_tiltDeg a owl:DatatypeProperty ;
    rdfs:label "TILT_DEG" ;
    rdfs:comment "IOT_SENSOR_READING.TILT_DEG" ;
    rdfs:domain sc:SensorReading ;
    rdfs:range xsd:decimal .

sc:sensorreading_gpsLat a owl:DatatypeProperty ;
    rdfs:label "GPS_LAT" ;
    rdfs:comment "IOT_SENSOR_READING.GPS_LAT" ;
    rdfs:domain sc:SensorReading ;
    rdfs:range xsd:decimal .

sc:sensorreading_gpsLon a owl:DatatypeProperty ;
    rdfs:label "GPS_LON" ;
    rdfs:comment "IOT_SENSOR_READING.GPS_LON" ;
    rdfs:domain sc:SensorReading ;
    rdfs:range xsd:decimal .

sc:sensorreading_breachFlag a owl:DatatypeProperty ;
    rdfs:label "BREACH_FLAG" ;
    rdfs:comment "TRUE if any reading exceeds threshold" ;
    rdfs:domain sc:SensorReading ;
    skos:altLabel "breach" ;
    skos:altLabel "excursion" ;
    skos:altLabel "threshold breach" ;
    skos:altLabel "cold chain breach" ;
    rdfs:range xsd:boolean .

#----------------------------------------------------------------------------
# WorkOrder  <-  SCS.INVENTORY.WORK_ORDER
#----------------------------------------------------------------------------

sc:WorkOrder a owl:Class ;
    rdfs:label "Work Order" ;
    rdfs:comment "Manufacturing work orders — 10,000" ;
    skos:altLabel "wo" ;
    skos:altLabel "production order" ;
    skos:altLabel "manufacturing order" ;
    skos:altLabel "WORK_ORDER" ;
    owl:hasKey ( sc:workorder_workOrderId ) ;
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty sc:workorder_workOrderId ; owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:workorder_productId ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:workorder_plantId ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:workorder_startDate ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:workorder_quantity ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:workorder_status ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

sc:workorder_workOrderId a owl:DatatypeProperty ;
    rdfs:label "WORK_ORDER_ID" ;
    rdfs:comment "WORK_ORDER.WORK_ORDER_ID" ;
    rdfs:domain sc:WorkOrder ;
    rdfs:range xsd:integer .

sc:workorder_productId a owl:ObjectProperty ;
    rdfs:label "produces product" ;
    rdfs:comment "Finished product the work order builds" ;
    rdfs:domain sc:WorkOrder ;
    rdfs:range sc:Product ;
    coa:fkProvenance "MANY_TO_ONE" .

sc:workorder_plantId a owl:ObjectProperty ;
    rdfs:label "runs at plant" ;
    rdfs:comment "Plant executing the work order" ;
    rdfs:domain sc:WorkOrder ;
    rdfs:range sc:Plant ;
    coa:fkProvenance "MANY_TO_ONE" .

sc:workorder_startDate a owl:DatatypeProperty ;
    rdfs:label "START_DATE" ;
    rdfs:comment "WORK_ORDER.START_DATE" ;
    rdfs:domain sc:WorkOrder ;
    rdfs:range xsd:date .

sc:workorder_endDate a owl:DatatypeProperty ;
    rdfs:label "END_DATE" ;
    rdfs:comment "WORK_ORDER.END_DATE" ;
    rdfs:domain sc:WorkOrder ;
    rdfs:range xsd:date .

sc:workorder_quantity a owl:DatatypeProperty ;
    rdfs:label "QUANTITY" ;
    rdfs:comment "WORK_ORDER.QUANTITY" ;
    rdfs:domain sc:WorkOrder ;
    rdfs:range xsd:decimal .

sc:workorder_status a owl:DatatypeProperty ;
    rdfs:label "STATUS" ;
    rdfs:comment "WORK_ORDER.STATUS" ;
    rdfs:domain sc:WorkOrder ;
    coa:distinctValues "COMPLETED" ;
    coa:distinctValues "IN_PROGRESS" ;
    coa:distinctValues "ON_HOLD" ;
    rdfs:range xsd:string .

#----------------------------------------------------------------------------
# QualityInspection  <-  SCS.INVENTORY.QUALITY_INSPECTION
#----------------------------------------------------------------------------

sc:QualityInspection a owl:Class ;
    rdfs:label "Quality Inspection" ;
    rdfs:comment "Incoming quality inspections — 10,000" ;
    skos:altLabel "incoming inspection" ;
    skos:altLabel "iqc" ;
    skos:altLabel "QUALITY_INSPECTION" ;
    skos:altLabel "quality check" ;
    owl:hasKey ( sc:qualityinspection_inspectionId ) ;
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty sc:qualityinspection_inspectionId ; owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:qualityinspection_receiptId ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:qualityinspection_partId ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:qualityinspection_supplierId ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:qualityinspection_inspectionDate ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:qualityinspection_sampleSize ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:qualityinspection_defectCount ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:qualityinspection_result ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:qualityinspection_ppm ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

sc:qualityinspection_inspectionId a owl:DatatypeProperty ;
    rdfs:label "INSPECTION_ID" ;
    rdfs:comment "QUALITY_INSPECTION.INSPECTION_ID" ;
    rdfs:domain sc:QualityInspection ;
    rdfs:range xsd:integer .

sc:qualityinspection_receiptId a owl:ObjectProperty ;
    rdfs:label "inspects receipt" ;
    rdfs:comment "Goods receipt that was inspected" ;
    rdfs:domain sc:QualityInspection ;
    rdfs:range sc:GoodsReceipt ;
    coa:fkProvenance "MANY_TO_ONE" .

sc:qualityinspection_partId a owl:ObjectProperty ;
    rdfs:label "inspected part" ;
    rdfs:comment "Part that was inspected" ;
    rdfs:domain sc:QualityInspection ;
    rdfs:range sc:Part ;
    coa:fkProvenance "MANY_TO_ONE" .

sc:qualityinspection_supplierId a owl:ObjectProperty ;
    rdfs:label "inspected supplier" ;
    rdfs:comment "Supplier whose material was inspected" ;
    rdfs:domain sc:QualityInspection ;
    rdfs:range sc:Supplier ;
    coa:fkProvenance "MANY_TO_ONE" .

sc:qualityinspection_inspectionDate a owl:DatatypeProperty ;
    rdfs:label "INSPECTION_DATE" ;
    rdfs:comment "QUALITY_INSPECTION.INSPECTION_DATE" ;
    rdfs:domain sc:QualityInspection ;
    rdfs:range xsd:date .

sc:qualityinspection_sampleSize a owl:DatatypeProperty ;
    rdfs:label "SAMPLE_SIZE" ;
    rdfs:comment "QUALITY_INSPECTION.SAMPLE_SIZE" ;
    rdfs:domain sc:QualityInspection ;
    rdfs:range xsd:integer .

sc:qualityinspection_defectCount a owl:DatatypeProperty ;
    rdfs:label "DEFECT_COUNT" ;
    rdfs:comment "QUALITY_INSPECTION.DEFECT_COUNT" ;
    rdfs:domain sc:QualityInspection ;
    skos:altLabel "defects" ;
    skos:altLabel "rejects" ;
    rdfs:range xsd:integer .

sc:qualityinspection_result a owl:DatatypeProperty ;
    rdfs:label "RESULT" ;
    rdfs:comment "PASS, FAIL, CONDITIONAL" ;
    rdfs:domain sc:QualityInspection ;
    coa:distinctValues "CONDITIONAL" ;
    coa:distinctValues "FAIL" ;
    coa:distinctValues "PASS" ;
    rdfs:range xsd:string .

sc:qualityinspection_ppm a owl:DatatypeProperty ;
    rdfs:label "PPM" ;
    rdfs:comment "Parts per million defect rate" ;
    rdfs:domain sc:QualityInspection ;
    skos:altLabel "defect rate" ;
    skos:altLabel "parts per million" ;
    skos:altLabel "ppm defect rate" ;
    rdfs:range xsd:decimal .

#----------------------------------------------------------------------------
# NonconformanceReport  <-  SCS.INVENTORY.NONCONFORMANCE_REPORT
#----------------------------------------------------------------------------

sc:NonconformanceReport a owl:Class ;
    rdfs:label "Nonconformance Report" ;
    rdfs:comment "Non-conformance reports — 1,000 NCRs" ;
    skos:altLabel "ncr" ;
    skos:altLabel "quality issue" ;
    skos:altLabel "defect report" ;
    skos:altLabel "NONCONFORMANCE_REPORT" ;
    skos:altLabel "car" ;
    owl:hasKey ( sc:nonconformancereport_ncrId ) ;
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty sc:nonconformancereport_ncrId ; owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:nonconformancereport_supplierId ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:nonconformancereport_partId ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:nonconformancereport_plantId ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:nonconformancereport_ncrDate ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:nonconformancereport_severity ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:nonconformancereport_disposition ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

sc:nonconformancereport_ncrId a owl:DatatypeProperty ;
    rdfs:label "NCR_ID" ;
    rdfs:comment "NONCONFORMANCE_REPORT.NCR_ID" ;
    rdfs:domain sc:NonconformanceReport ;
    rdfs:range xsd:integer .

sc:nonconformancereport_inspectionId a owl:ObjectProperty ;
    rdfs:label "raised from inspection" ;
    rdfs:comment "Inspection that triggered the NCR; null when raised in production" ;
    rdfs:domain sc:NonconformanceReport ;
    rdfs:range sc:QualityInspection ;
    coa:fkProvenance "MANY_TO_ONE" .

sc:nonconformancereport_supplierId a owl:ObjectProperty ;
    rdfs:label "supplier at fault" ;
    rdfs:comment "Supplier held responsible for the nonconformance" ;
    rdfs:domain sc:NonconformanceReport ;
    rdfs:range sc:Supplier ;
    coa:fkProvenance "MANY_TO_ONE" .

sc:nonconformancereport_partId a owl:ObjectProperty ;
    rdfs:label "nonconforming part" ;
    rdfs:comment "Part found nonconforming" ;
    rdfs:domain sc:NonconformanceReport ;
    rdfs:range sc:Part ;
    coa:fkProvenance "MANY_TO_ONE" .

sc:nonconformancereport_plantId a owl:ObjectProperty ;
    rdfs:label "raised at plant" ;
    rdfs:comment "Plant that raised the NCR" ;
    rdfs:domain sc:NonconformanceReport ;
    rdfs:range sc:Plant ;
    coa:fkProvenance "MANY_TO_ONE" .

sc:nonconformancereport_ncrDate a owl:DatatypeProperty ;
    rdfs:label "NCR_DATE" ;
    rdfs:comment "NONCONFORMANCE_REPORT.NCR_DATE" ;
    rdfs:domain sc:NonconformanceReport ;
    rdfs:range xsd:date .

sc:nonconformancereport_severity a owl:DatatypeProperty ;
    rdfs:label "SEVERITY" ;
    rdfs:comment "CRITICAL, MAJOR, MINOR" ;
    rdfs:domain sc:NonconformanceReport ;
    coa:distinctValues "CRITICAL" ;
    coa:distinctValues "MAJOR" ;
    coa:distinctValues "MINOR" ;
    rdfs:range xsd:string .

sc:nonconformancereport_rootCause a owl:DatatypeProperty ;
    rdfs:label "ROOT_CAUSE" ;
    rdfs:comment "NONCONFORMANCE_REPORT.ROOT_CAUSE" ;
    rdfs:domain sc:NonconformanceReport ;
    coa:distinctValues "Cracked substrate from shock" ;
    coa:distinctValues "Dimensional out-of-spec" ;
    coa:distinctValues "Documentation mismatch" ;
    coa:distinctValues "ESD damage in shipping" ;
    coa:distinctValues "Electrical test failure" ;
    coa:distinctValues "Material contamination" ;
    coa:distinctValues "Solder joint defect" ;
    coa:distinctValues "Surface finish degradation" ;
    coa:distinctValues "Unapproved substitution" ;
    coa:distinctValues "Wrong revision shipped" ;
    rdfs:range xsd:string .

sc:nonconformancereport_disposition a owl:DatatypeProperty ;
    rdfs:label "DISPOSITION" ;
    rdfs:comment "SCRAP, REWORK, USE_AS_IS, RETURN" ;
    rdfs:domain sc:NonconformanceReport ;
    coa:distinctValues "RETURN" ;
    coa:distinctValues "REWORK" ;
    coa:distinctValues "SCRAP" ;
    coa:distinctValues "USE_AS_IS" ;
    rdfs:range xsd:string .

sc:nonconformancereport_status a owl:DatatypeProperty ;
    rdfs:label "STATUS" ;
    rdfs:comment "NONCONFORMANCE_REPORT.STATUS" ;
    rdfs:domain sc:NonconformanceReport ;
    coa:distinctValues "CLOSED" ;
    coa:distinctValues "OPEN" ;
    rdfs:range xsd:string .

#----------------------------------------------------------------------------
# InventorySnapshot  <-  SCS.INVENTORY.FACT_INVENTORY_SNAPSHOT
#----------------------------------------------------------------------------

sc:InventorySnapshot a owl:Class ;
    rdfs:label "Inventory Snapshot" ;
    rdfs:comment "Inventory snapshots — ~1.2M rows (part x warehouse x month-end)" ;
    skos:altLabel "stock on hand" ;
    skos:altLabel "inventory position" ;
    skos:altLabel "soh" ;
    skos:altLabel "FACT_INVENTORY_SNAPSHOT" ;
    skos:altLabel "stock level" ;
    owl:hasKey ( sc:inventorysnapshot_snapshotId ) ;
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty sc:inventorysnapshot_snapshotId ; owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:inventorysnapshot_snapshotDate ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:inventorysnapshot_partId ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:inventorysnapshot_warehouseId ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:inventorysnapshot_onHandQty ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:inventorysnapshot_unitCostUsd ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:inventorysnapshot_onHandValue ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

sc:inventorysnapshot_snapshotId a owl:DatatypeProperty ;
    rdfs:label "SNAPSHOT_ID" ;
    rdfs:comment "FACT_INVENTORY_SNAPSHOT.SNAPSHOT_ID" ;
    rdfs:domain sc:InventorySnapshot ;
    rdfs:range xsd:integer .

sc:inventorysnapshot_snapshotDate a owl:ObjectProperty ;
    rdfs:label "as of date" ;
    rdfs:comment "Calendar date the snapshot was taken; join here for year, quarter and fiscal period" ;
    rdfs:domain sc:InventorySnapshot ;
    rdfs:range sc:CalendarDate ;
    coa:fkProvenance "MANY_TO_ONE" .

sc:inventorysnapshot_partId a owl:ObjectProperty ;
    rdfs:label "stock of part" ;
    rdfs:comment "Part the stock position is measured for" ;
    rdfs:domain sc:InventorySnapshot ;
    rdfs:range sc:Part ;
    coa:fkProvenance "MANY_TO_ONE" .

sc:inventorysnapshot_warehouseId a owl:ObjectProperty ;
    rdfs:label "stock at warehouse" ;
    rdfs:comment "Warehouse holding the stock" ;
    rdfs:domain sc:InventorySnapshot ;
    rdfs:range sc:Warehouse ;
    coa:fkProvenance "MANY_TO_ONE" .

sc:inventorysnapshot_onHandQty a owl:DatatypeProperty ;
    rdfs:label "ON_HAND_QTY" ;
    rdfs:comment "FACT_INVENTORY_SNAPSHOT.ON_HAND_QTY" ;
    rdfs:domain sc:InventorySnapshot ;
    skos:altLabel "stock on hand" ;
    skos:altLabel "soh" ;
    skos:altLabel "on hand quantity" ;
    skos:altLabel "inventory quantity" ;
    rdfs:range xsd:decimal .

sc:inventorysnapshot_unitCostUsd a owl:DatatypeProperty ;
    rdfs:label "UNIT_COST_USD" ;
    rdfs:comment "FACT_INVENTORY_SNAPSHOT.UNIT_COST_USD" ;
    rdfs:domain sc:InventorySnapshot ;
    rdfs:range xsd:decimal .

sc:inventorysnapshot_onHandValue a owl:DatatypeProperty ;
    rdfs:label "ON_HAND_VALUE" ;
    rdfs:comment "on_hand_qty * unit_cost_usd" ;
    rdfs:domain sc:InventorySnapshot ;
    skos:altLabel "inventory value" ;
    skos:altLabel "stock value" ;
    skos:altLabel "tied up capital" ;
    rdfs:range xsd:decimal .

sc:inventorysnapshot_dailyUsageQty a owl:DatatypeProperty ;
    rdfs:label "DAILY_USAGE_QTY" ;
    rdfs:comment "Average daily consumption" ;
    rdfs:domain sc:InventorySnapshot ;
    skos:altLabel "daily usage" ;
    skos:altLabel "consumption rate" ;
    skos:altLabel "burn rate" ;
    rdfs:range xsd:decimal .

sc:inventorysnapshot_doi a owl:DatatypeProperty ;
    rdfs:label "DOI" ;
    rdfs:comment "Days of inventory = on_hand / daily_usage" ;
    rdfs:domain sc:InventorySnapshot ;
    skos:altLabel "days of inventory" ;
    skos:altLabel "days of supply" ;
    skos:altLabel "dos" ;
    skos:altLabel "coverage days" ;
    rdfs:range xsd:decimal .

