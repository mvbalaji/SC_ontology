    rdfs:comment "DIM_GEO_COUNTRY.COUNTRY_CODE" ;
    rdfs:domain sc:Country ;
    rdfs:range xsd:string .

sc:country_regionId a owl:ObjectProperty ;
    rdfs:label "in region" ;
    rdfs:comment "Geographic region the country belongs to" ;
    rdfs:domain sc:Country ;
    rdfs:range sc:Region ;
    coa:fkProvenance "MANY_TO_ONE" .

