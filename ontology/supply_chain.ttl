        [ a owl:Restriction ; owl:onProperty sc:lane_laneId ; owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:lane_originPortId ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:lane_destPortId ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:lane_transportMode ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:lane_transitDaysAvg ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

sc:lane_laneId a owl:DatatypeProperty ;
    rdfs:label "LANE_ID" ;
    rdfs:comment "DIM_LANE.LANE_ID" ;
    rdfs:domain sc:Lane ;
    rdfs:range xsd:integer .

sc:lane_originPortId a owl:ObjectProperty ;
    rdfs:label "origin port" ;
    rdfs:comment "Port the lane departs from" ;
    rdfs:domain sc:Lane ;
    rdfs:range sc:Port ;
    coa:fkProvenance "MANY_TO_ONE" .

sc:lane_destPortId a owl:ObjectProperty ;
    rdfs:label "destination port" ;
    rdfs:comment "Port the lane arrives at" ;
    rdfs:domain sc:Lane ;
    rdfs:range sc:Port ;
    coa:fkProvenance "MANY_TO_ONE" .

sc:lane_transportMode a owl:DatatypeProperty ;
    rdfs:label "TRANSPORT_MODE" ;
    rdfs:comment "DIM_LANE.TRANSPORT_MODE" ;
    rdfs:domain sc:Lane ;
    coa:distinctValues "AIR" ;
    coa:distinctValues "OCEAN" ;
    rdfs:range xsd:string .

sc:lane_transitDaysAvg a owl:DatatypeProperty ;
    rdfs:label "TRANSIT_DAYS_AVG" ;
    rdfs:comment "DIM_LANE.TRANSIT_DAYS_AVG" ;
    rdfs:domain sc:Lane ;
    skos:altLabel "transit time" ;
    skos:altLabel "average transit days" ;
    rdfs:range xsd:integer .

sc:lane_isProblemLane a owl:DatatypeProperty ;
    rdfs:label "IS_PROBLEM_LANE" ;
    rdfs:comment "DIM_LANE.IS_PROBLEM_LANE" ;
    rdfs:domain sc:Lane ;
    rdfs:range xsd:boolean .

