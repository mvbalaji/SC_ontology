# Supply Chain Ontology — Asterion Devices (synthetic)
# Generated by generate_ontology.py from 01_base_tables_and_data.sql. Do not hand-edit.
#
# Target: AWS Context Ontology Accelerator
#   POST /namespaces/{ns}/ontologies/{ontologyId}/upload
#
# Conventions (packages/ontology-engine/docs/ontology-data-model.md):
#   - owl:imports is never emitted: Ontop network-resolves imports at VKG load
#     and fails every query in the namespace on a non-dereferenceable IRI.
#   - coa:isMapped is never emitted: it is server-derived from R2RML rr:class
#     membership and caller-supplied triples are stripped at ingest.
#   - FK join keys live only in the R2RML; the T-Box carries what the
#     relationship means (domain, range, coa:fkProvenance).

@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix coa:  <http://coa.amazon.com/vocab/coa#> .
@prefix sc:   <https://asterion.example.com/ontology/supplychain#> .

<https://asterion.example.com/ontology/supplychain> a owl:Ontology ;
    rdfs:label "Asterion Supply Chain Ontology" ;
    rdfs:comment "Electronics manufacturing supply chain: sourcing, procurement, inbound quality, manufacturing, inventory, logistics and demand. Induced from the SCS.INVENTORY Snowflake schema — 37 tables covering supplier master and approvals, purchase orders and receipts, bills of material, work orders, inventory snapshots, shipments with lane and carrier detail, IoT cold-chain telemetry, and quality inspections and nonconformances. All data is synthetic." ;
    owl:versionInfo "1.0.0" .

#----------------------------------------------------------------------------
# CalendarDate  <-  SCS.INVENTORY.DIM_DATE
#----------------------------------------------------------------------------

sc:CalendarDate a owl:Class ;
    rdfs:label "Calendar Date" ;
    rdfs:comment "Calendar dimension from 2022-01-01 to 2026-12-31" ;
    skos:altLabel "date" ;
    skos:altLabel "day" ;
    skos:altLabel "calendar" ;
    skos:altLabel "DIM_DATE" ;
    skos:altLabel "time dimension" ;
    owl:hasKey ( sc:calendardate_dateKey ) ;
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty sc:calendardate_dateKey ; owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:calendardate_year ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:calendardate_quarter ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:calendardate_month ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:calendardate_monthName ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:calendardate_weekOfYear ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:calendardate_dayOfWeek ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:calendardate_dayName ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:calendardate_isWeekend ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:calendardate_fiscalYear ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:calendardate_fiscalQuarter ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

sc:calendardate_dateKey a owl:DatatypeProperty ;
    rdfs:label "DATE_KEY" ;
    rdfs:comment "DIM_DATE.DATE_KEY" ;
    rdfs:domain sc:CalendarDate ;
    rdfs:range xsd:date .

sc:calendardate_year a owl:DatatypeProperty ;
    rdfs:label "YEAR" ;
    rdfs:comment "DIM_DATE.YEAR" ;
    rdfs:domain sc:CalendarDate ;
    rdfs:range xsd:integer .

sc:calendardate_quarter a owl:DatatypeProperty ;
    rdfs:label "QUARTER" ;
    rdfs:comment "DIM_DATE.QUARTER" ;
    rdfs:domain sc:CalendarDate ;
    rdfs:range xsd:integer .

sc:calendardate_month a owl:DatatypeProperty ;
    rdfs:label "MONTH" ;
    rdfs:comment "DIM_DATE.MONTH" ;
    rdfs:domain sc:CalendarDate ;
    rdfs:range xsd:integer .

sc:calendardate_monthName a owl:DatatypeProperty ;
    rdfs:label "MONTH_NAME" ;
    rdfs:comment "DIM_DATE.MONTH_NAME" ;
    rdfs:domain sc:CalendarDate ;
    coa:distinctValues "Apr" ;
    coa:distinctValues "Aug" ;
    coa:distinctValues "Dec" ;
    coa:distinctValues "Feb" ;
    coa:distinctValues "Jan" ;
    coa:distinctValues "Jul" ;
    coa:distinctValues "Jun" ;
    coa:distinctValues "Mar" ;
    coa:distinctValues "May" ;
    coa:distinctValues "Nov" ;
    coa:distinctValues "Oct" ;
    coa:distinctValues "Sep" ;
    rdfs:range xsd:string .

sc:calendardate_weekOfYear a owl:DatatypeProperty ;
    rdfs:label "WEEK_OF_YEAR" ;
    rdfs:comment "DIM_DATE.WEEK_OF_YEAR" ;
    rdfs:domain sc:CalendarDate ;
    rdfs:range xsd:integer .

sc:calendardate_dayOfWeek a owl:DatatypeProperty ;
    rdfs:label "DAY_OF_WEEK" ;
    rdfs:comment "DIM_DATE.DAY_OF_WEEK" ;
    rdfs:domain sc:CalendarDate ;
    rdfs:range xsd:integer .

sc:calendardate_dayName a owl:DatatypeProperty ;
    rdfs:label "DAY_NAME" ;
    rdfs:comment "DIM_DATE.DAY_NAME" ;
    rdfs:domain sc:CalendarDate ;
    coa:distinctValues "Fri" ;
    coa:distinctValues "Mon" ;
    coa:distinctValues "Sat" ;
    coa:distinctValues "Sun" ;
    coa:distinctValues "Thu" ;
    coa:distinctValues "Tue" ;
    coa:distinctValues "Wed" ;
    rdfs:range xsd:string .

sc:calendardate_isWeekend a owl:DatatypeProperty ;
    rdfs:label "IS_WEEKEND" ;
    rdfs:comment "DIM_DATE.IS_WEEKEND" ;
    rdfs:domain sc:CalendarDate ;
    rdfs:range xsd:boolean .

sc:calendardate_fiscalYear a owl:DatatypeProperty ;
    rdfs:label "FISCAL_YEAR" ;
    rdfs:comment "DIM_DATE.FISCAL_YEAR" ;
    rdfs:domain sc:CalendarDate ;
    rdfs:range xsd:integer .

sc:calendardate_fiscalQuarter a owl:DatatypeProperty ;
    rdfs:label "FISCAL_QUARTER" ;
    rdfs:comment "DIM_DATE.FISCAL_QUARTER" ;
    rdfs:domain sc:CalendarDate ;
    rdfs:range xsd:integer .

