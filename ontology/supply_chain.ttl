#----------------------------------------------------------------------------
# Part  <-  SCS.INVENTORY.DIM_PART
#----------------------------------------------------------------------------

sc:Part a owl:Class ;
    rdfs:label "Part" ;
    rdfs:comment "Part master — 30,000 parts across all commodities" ;
    skos:altLabel "component" ;
    skos:altLabel "material" ;
    skos:altLabel "sku" ;
    skos:altLabel "item" ;
    skos:altLabel "DIM_PART" ;
    skos:altLabel "part master" ;
    owl:hasKey ( sc:part_partId ) ;
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty sc:part_partId ; owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:part_partNumber ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:part_partName ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:part_commodityId ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:part_subCommodityId ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:part_unitCostUsd ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

sc:part_partId a owl:DatatypeProperty ;
    rdfs:label "PART_ID" ;
    rdfs:comment "DIM_PART.PART_ID" ;
    rdfs:domain sc:Part ;
    rdfs:range xsd:integer .

sc:part_partNumber a owl:DatatypeProperty ;
    rdfs:label "PART_NUMBER" ;
    rdfs:comment "DIM_PART.PART_NUMBER" ;
    rdfs:domain sc:Part ;
    rdfs:range xsd:string .

sc:part_partName a owl:DatatypeProperty ;
    rdfs:label "PART_NAME" ;
    rdfs:comment "DIM_PART.PART_NAME" ;
    rdfs:domain sc:Part ;
    rdfs:range xsd:string .

sc:part_commodityId a owl:ObjectProperty ;
    rdfs:label "classified as commodity" ;
    rdfs:comment "Top-level commodity classification of the part" ;
    rdfs:domain sc:Part ;
    rdfs:range sc:Commodity ;
    coa:fkProvenance "MANY_TO_ONE" .

sc:part_subCommodityId a owl:ObjectProperty ;
    rdfs:label "classified as sub-commodity" ;
    rdfs:comment "Sub-commodity classification of the part" ;
    rdfs:domain sc:Part ;
    rdfs:range sc:SubCommodity ;
    coa:fkProvenance "MANY_TO_ONE" .

sc:part_uomCode a owl:ObjectProperty ;
    rdfs:label "measured in" ;
    rdfs:comment "Unit of measure the part is transacted in" ;
    rdfs:domain sc:Part ;
    rdfs:range sc:UnitOfMeasure ;
    coa:fkProvenance "MANY_TO_ONE" .

sc:part_unitCostUsd a owl:DatatypeProperty ;
    rdfs:label "UNIT_COST_USD" ;
    rdfs:comment "Standard cost in USD" ;
    rdfs:domain sc:Part ;
    skos:altLabel "standard cost" ;
    skos:altLabel "part cost" ;
    skos:altLabel "unit cost" ;
    rdfs:range xsd:decimal .

sc:part_weightKg a owl:DatatypeProperty ;
    rdfs:label "WEIGHT_KG" ;
    rdfs:comment "DIM_PART.WEIGHT_KG" ;
    rdfs:domain sc:Part ;
    rdfs:range xsd:decimal .

sc:part_lifecycleStatus a owl:DatatypeProperty ;
    rdfs:label "LIFECYCLE_STATUS" ;
    rdfs:comment "ACTIVE, EOL, OBSOLETE, NRND" ;
    rdfs:domain sc:Part ;
    skos:altLabel "lifecycle" ;
    skos:altLabel "eol status" ;
    skos:altLabel "part status" ;
    coa:distinctValues "ACTIVE" ;
    coa:distinctValues "EOL" ;
    coa:distinctValues "NRND" ;
    coa:distinctValues "OBSOLETE" ;
    rdfs:range xsd:string .

sc:part_isSynthetic a owl:DatatypeProperty ;
    rdfs:label "IS_SYNTHETIC" ;
    rdfs:comment "DIM_PART.IS_SYNTHETIC" ;
    rdfs:domain sc:Part ;
    rdfs:range xsd:boolean .

