# Port  <-  SCS.INVENTORY.DIM_PORT
#----------------------------------------------------------------------------

sc:Port a owl:Class ;
    rdfs:label "Port" ;
    rdfs:comment "Major ports and airports for logistics" ;
    skos:altLabel "seaport" ;
    skos:altLabel "airport" ;
    skos:altLabel "terminal" ;
    skos:altLabel "DIM_PORT" ;
    owl:hasKey ( sc:port_portId ) ;
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty sc:port_portId ; owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:port_portName ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:port_portCode ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:port_countryId ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:port_portType ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

sc:port_portId a owl:DatatypeProperty ;
    rdfs:label "PORT_ID" ;
    rdfs:comment "DIM_PORT.PORT_ID" ;
    rdfs:domain sc:Port ;
    rdfs:range xsd:integer .

sc:port_portName a owl:DatatypeProperty ;
    rdfs:label "PORT_NAME" ;
    rdfs:comment "DIM_PORT.PORT_NAME" ;
    rdfs:domain sc:Port ;
    rdfs:range xsd:string .

sc:port_portCode a owl:DatatypeProperty ;
    rdfs:label "PORT_CODE" ;
    rdfs:comment "DIM_PORT.PORT_CODE" ;
    rdfs:domain sc:Port ;
    rdfs:range xsd:string .

sc:port_countryId a owl:ObjectProperty ;
    rdfs:label "countryId" ;
    rdfs:comment "Foreign key: DIM_PORT.COUNTRY_ID references DIM_GEO_COUNTRY.COUNTRY_ID" ;
    rdfs:domain sc:Port ;
    rdfs:range sc:Country ;
    coa:fkProvenance "MANY_TO_ONE" .

sc:port_portType a owl:DatatypeProperty ;
    rdfs:label "PORT_TYPE" ;
    rdfs:comment "SEA, AIR, or BOTH" ;
    rdfs:domain sc:Port ;
    coa:distinctValues "AIR" ;
    coa:distinctValues "BOTH" ;
    coa:distinctValues "SEA" ;
    rdfs:range xsd:string .

#----------------------------------------------------------------------------
# Supplier  <-  SCS.INVENTORY.DIM_SUPPLIER
#----------------------------------------------------------------------------

sc:Supplier a owl:Class ;
    rdfs:label "Supplier" ;
    rdfs:comment "Supplier master — 500 suppliers across commodities and countries" ;
    skos:altLabel "vendor" ;
    skos:altLabel "supplier master" ;
    skos:altLabel "DIM_SUPPLIER" ;
    skos:altLabel "source" ;
    skos:altLabel "seller" ;
    owl:hasKey ( sc:supplier_supplierId ) ;
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty sc:supplier_supplierId ; owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:supplier_supplierName ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:supplier_supplierCode ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:supplier_countryId ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:supplier_commodityId ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:supplier_reliabilityRating ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

sc:supplier_supplierId a owl:DatatypeProperty ;
    rdfs:label "SUPPLIER_ID" ;
    rdfs:comment "DIM_SUPPLIER.SUPPLIER_ID" ;
    rdfs:domain sc:Supplier ;
    rdfs:range xsd:integer .

sc:supplier_supplierName a owl:DatatypeProperty ;
    rdfs:label "SUPPLIER_NAME" ;
    rdfs:comment "DIM_SUPPLIER.SUPPLIER_NAME" ;
    rdfs:domain sc:Supplier ;
    rdfs:range xsd:string .

sc:supplier_supplierCode a owl:DatatypeProperty ;
    rdfs:label "SUPPLIER_CODE" ;
    rdfs:comment "DIM_SUPPLIER.SUPPLIER_CODE" ;
    rdfs:domain sc:Supplier ;
    rdfs:range xsd:string .

sc:supplier_countryId a owl:ObjectProperty ;
    rdfs:label "located in country" ;
    rdfs:comment "Country the supplier is headquartered in" ;
    rdfs:domain sc:Supplier ;
    rdfs:range sc:Country ;
    coa:fkProvenance "MANY_TO_ONE" .

sc:supplier_commodityId a owl:ObjectProperty ;
    rdfs:label "supplies commodity" ;
    rdfs:comment "Primary commodity this supplier is sourced for" ;
    rdfs:domain sc:Supplier ;
    rdfs:range sc:Commodity ;
    coa:fkProvenance "MANY_TO_ONE" .

sc:supplier_reliabilityRating a owl:DatatypeProperty ;
    rdfs:label "RELIABILITY_RATING" ;
    rdfs:comment "0.00-1.00 scale" ;
    rdfs:domain sc:Supplier ;
    skos:altLabel "reliability" ;
    skos:altLabel "supplier score" ;
    skos:altLabel "otd rating" ;
    rdfs:range xsd:decimal .

sc:supplier_isProblem a owl:DatatypeProperty ;
    rdfs:label "IS_PROBLEM" ;
    rdfs:comment "Flagged problem supplier for demo scenarios" ;
    rdfs:domain sc:Supplier ;
    skos:altLabel "problem supplier" ;
    skos:altLabel "at risk supplier" ;
    skos:altLabel "flagged supplier" ;
    rdfs:range xsd:boolean .

sc:supplier_active a owl:DatatypeProperty ;
    rdfs:label "ACTIVE" ;
    rdfs:comment "DIM_SUPPLIER.ACTIVE" ;
    rdfs:domain sc:Supplier ;
    rdfs:range xsd:boolean .

sc:supplier_isSynthetic a owl:DatatypeProperty ;
    rdfs:label "IS_SYNTHETIC" ;
    rdfs:comment "DIM_SUPPLIER.IS_SYNTHETIC" ;
    rdfs:domain sc:Supplier ;
    rdfs:range xsd:boolean .

#----------------------------------------------------------------------------
# SupplierSite  <-  SCS.INVENTORY.DIM_SUPPLIER_SITE
#----------------------------------------------------------------------------

sc:SupplierSite a owl:Class ;
    rdfs:label "Supplier Site" ;
    rdfs:comment "Supplier manufacturing and shipping sites" ;
    skos:altLabel "supplier facility" ;
    skos:altLabel "vendor site" ;
    skos:altLabel "DIM_SUPPLIER_SITE" ;
    skos:altLabel "manufacturing site" ;
    owl:hasKey ( sc:suppliersite_siteId ) ;
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty sc:suppliersite_siteId ; owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:suppliersite_supplierId ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:suppliersite_siteName ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:suppliersite_city ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:suppliersite_countryId ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:suppliersite_leadTimeDays ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

sc:suppliersite_siteId a owl:DatatypeProperty ;
    rdfs:label "SITE_ID" ;
    rdfs:comment "DIM_SUPPLIER_SITE.SITE_ID" ;
    rdfs:domain sc:SupplierSite ;
    rdfs:range xsd:integer .

sc:suppliersite_supplierId a owl:ObjectProperty ;
    rdfs:label "belongs to supplier" ;
    rdfs:comment "Parent supplier that owns this site" ;
    rdfs:domain sc:SupplierSite ;
    rdfs:range sc:Supplier ;
    coa:fkProvenance "MANY_TO_ONE" .

sc:suppliersite_siteName a owl:DatatypeProperty ;
    rdfs:label "SITE_NAME" ;
    rdfs:comment "DIM_SUPPLIER_SITE.SITE_NAME" ;
    rdfs:domain sc:SupplierSite ;
    rdfs:range xsd:string .

sc:suppliersite_city a owl:DatatypeProperty ;
    rdfs:label "CITY" ;
    rdfs:comment "DIM_SUPPLIER_SITE.CITY" ;
    rdfs:domain sc:SupplierSite ;
    rdfs:range xsd:string .

sc:suppliersite_countryId a owl:ObjectProperty ;
    rdfs:label "countryId" ;
    rdfs:comment "Foreign key: DIM_SUPPLIER_SITE.COUNTRY_ID references DIM_GEO_COUNTRY.COUNTRY_ID" ;
    rdfs:domain sc:SupplierSite ;
    rdfs:range sc:Country ;
    coa:fkProvenance "MANY_TO_ONE" .

sc:suppliersite_leadTimeDays a owl:DatatypeProperty ;
    rdfs:label "LEAD_TIME_DAYS" ;
    rdfs:comment "Average lead time in calendar days" ;
    rdfs:domain sc:SupplierSite ;
    skos:altLabel "lead time" ;
    skos:altLabel "replenishment lead time" ;
    rdfs:range xsd:integer .

sc:suppliersite_isPrimary a owl:DatatypeProperty ;
    rdfs:label "IS_PRIMARY" ;
    rdfs:comment "DIM_SUPPLIER_SITE.IS_PRIMARY" ;
    rdfs:domain sc:SupplierSite ;
    rdfs:range xsd:boolean .

sc:suppliersite_active a owl:DatatypeProperty ;
    rdfs:label "ACTIVE" ;
    rdfs:comment "DIM_SUPPLIER_SITE.ACTIVE" ;
    rdfs:domain sc:SupplierSite ;
    rdfs:range xsd:boolean .

