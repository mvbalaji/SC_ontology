sc:product_isSynthetic a owl:DatatypeProperty ;
    rdfs:label "IS_SYNTHETIC" ;
    rdfs:comment "DIM_PRODUCT.IS_SYNTHETIC" ;
    rdfs:domain sc:Product ;
    rdfs:range xsd:boolean .

#----------------------------------------------------------------------------
# BillOfMaterials  <-  SCS.INVENTORY.BOM_HEADER
#----------------------------------------------------------------------------

sc:BillOfMaterials a owl:Class ;
    rdfs:label "Bill of Materials" ;
    rdfs:comment "Bill of Materials headers — one per product revision" ;
    skos:altLabel "bom" ;
    skos:altLabel "BOM_HEADER" ;
    skos:altLabel "product structure" ;
    skos:altLabel "recipe" ;
    owl:hasKey ( sc:billofmaterials_bomId ) ;
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty sc:billofmaterials_bomId ; owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:billofmaterials_productId ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:billofmaterials_bomVersion ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:billofmaterials_effectiveDate ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

sc:billofmaterials_bomId a owl:DatatypeProperty ;
    rdfs:label "BOM_ID" ;
    rdfs:comment "BOM_HEADER.BOM_ID" ;
    rdfs:domain sc:BillOfMaterials ;
    rdfs:range xsd:integer .

sc:billofmaterials_productId a owl:ObjectProperty ;
    rdfs:label "builds product" ;
    rdfs:comment "Finished product this bill of materials builds" ;
    rdfs:domain sc:BillOfMaterials ;
    rdfs:range sc:Product ;
    coa:fkProvenance "MANY_TO_ONE" .

sc:billofmaterials_bomVersion a owl:DatatypeProperty ;
    rdfs:label "BOM_VERSION" ;
    rdfs:comment "BOM_HEADER.BOM_VERSION" ;
    rdfs:domain sc:BillOfMaterials ;
    coa:distinctValues "A" ;
    coa:distinctValues "B" ;
    coa:distinctValues "C" ;
    rdfs:range xsd:string .

sc:billofmaterials_effectiveDate a owl:DatatypeProperty ;
    rdfs:label "EFFECTIVE_DATE" ;
    rdfs:comment "BOM_HEADER.EFFECTIVE_DATE" ;
    rdfs:domain sc:BillOfMaterials ;
    rdfs:range xsd:date .

sc:billofmaterials_status a owl:DatatypeProperty ;
    rdfs:label "STATUS" ;
    rdfs:comment "BOM_HEADER.STATUS" ;
    rdfs:domain sc:BillOfMaterials ;
    coa:distinctValues "ACTIVE" ;
    rdfs:range xsd:string .

#----------------------------------------------------------------------------
# BillOfMaterialsLine  <-  SCS.INVENTORY.BOM_LINE
#----------------------------------------------------------------------------

sc:BillOfMaterialsLine a owl:Class ;
    rdfs:label "Bill of Materials Line" ;
    rdfs:comment "BOM line items — components per assembly" ;
    skos:altLabel "bom line" ;
    skos:altLabel "bom component" ;
    skos:altLabel "BOM_LINE" ;
    owl:hasKey ( sc:billofmaterialsline_bomLineId ) ;
