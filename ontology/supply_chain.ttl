        [ a owl:Restriction ; owl:onProperty sc:carrier_carrierId ; owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:carrier_carrierName ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:carrier_carrierMode ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

sc:carrier_carrierId a owl:DatatypeProperty ;
    rdfs:label "CARRIER_ID" ;
    rdfs:comment "DIM_CARRIER.CARRIER_ID" ;
    rdfs:domain sc:Carrier ;
    rdfs:range xsd:integer .

sc:carrier_carrierName a owl:DatatypeProperty ;
    rdfs:label "CARRIER_NAME" ;
    rdfs:comment "DIM_CARRIER.CARRIER_NAME" ;
    rdfs:domain sc:Carrier ;
    rdfs:range xsd:string .

sc:carrier_carrierMode a owl:DatatypeProperty ;
    rdfs:label "CARRIER_MODE" ;
    rdfs:comment "OCEAN, AIR, TRUCK, RAIL, MULTIMODAL" ;
    rdfs:domain sc:Carrier ;
    coa:distinctValues "AIR" ;
    coa:distinctValues "MULTIMODAL" ;
    coa:distinctValues "OCEAN" ;
    coa:distinctValues "RAIL" ;
    coa:distinctValues "TRUCK" ;
    rdfs:range xsd:string .

#----------------------------------------------------------------------------
# Lane  <-  SCS.INVENTORY.DIM_LANE
#----------------------------------------------------------------------------

sc:Lane a owl:Class ;
    rdfs:label "Lane" ;
    rdfs:comment "Shipping lanes between ports" ;
    skos:altLabel "shipping lane" ;
    skos:altLabel "trade lane" ;
    skos:altLabel "route" ;
    skos:altLabel "DIM_LANE" ;
    skos:altLabel "corridor" ;
