# Region  <-  SCS.INVENTORY.DIM_GEO_REGION
#----------------------------------------------------------------------------

sc:Region a owl:Class ;
    rdfs:label "Region" ;
    rdfs:comment "Geographic regions" ;
    skos:altLabel "geography" ;
    skos:altLabel "geo region" ;
    skos:altLabel "DIM_GEO_REGION" ;
    skos:altLabel "world region" ;
    owl:hasKey ( sc:region_regionId ) ;
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty sc:region_regionId ; owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:region_regionName ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

sc:region_regionId a owl:DatatypeProperty ;
    rdfs:label "REGION_ID" ;
    rdfs:comment "DIM_GEO_REGION.REGION_ID" ;
    rdfs:domain sc:Region ;
    rdfs:range xsd:integer .

sc:region_regionName a owl:DatatypeProperty ;
    rdfs:label "REGION_NAME" ;
    rdfs:comment "DIM_GEO_REGION.REGION_NAME" ;
    rdfs:domain sc:Region ;
    rdfs:range xsd:string .

