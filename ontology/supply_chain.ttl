sc:purchaseorder_poNumber a owl:DatatypeProperty ;
    rdfs:label "PO_NUMBER" ;
    rdfs:comment "PO_HEADER.PO_NUMBER" ;
    rdfs:domain sc:PurchaseOrder ;
    rdfs:range xsd:string .

sc:purchaseorder_supplierId a owl:ObjectProperty ;
    rdfs:label "ordered from supplier" ;
    rdfs:comment "Supplier the purchase order was placed with" ;
    rdfs:domain sc:PurchaseOrder ;
    rdfs:range sc:Supplier ;
    coa:fkProvenance "MANY_TO_ONE" .

sc:purchaseorder_plantId a owl:ObjectProperty ;
    rdfs:label "ordered for plant" ;
    rdfs:comment "Plant the purchase order is destined for" ;
    rdfs:domain sc:PurchaseOrder ;
    rdfs:range sc:Plant ;
    coa:fkProvenance "MANY_TO_ONE" .

sc:purchaseorder_orderDate a owl:DatatypeProperty ;
    rdfs:label "ORDER_DATE" ;
    rdfs:comment "PO_HEADER.ORDER_DATE" ;
    rdfs:domain sc:PurchaseOrder ;
    rdfs:range xsd:date .

sc:purchaseorder_currencyCode a owl:ObjectProperty ;
    rdfs:label "currencyCode" ;
    rdfs:comment "Foreign key: PO_HEADER.CURRENCY_CODE references DIM_CURRENCY.CURRENCY_CODE" ;
    rdfs:domain sc:PurchaseOrder ;
    rdfs:range sc:Currency ;
    coa:fkProvenance "MANY_TO_ONE" .

sc:purchaseorder_status a owl:DatatypeProperty ;
    rdfs:label "STATUS" ;
    rdfs:comment "OPEN, RECEIVED, PARTIAL, CANCELLED" ;
    rdfs:domain sc:PurchaseOrder ;
    coa:distinctValues "CANCELLED" ;
    coa:distinctValues "OPEN" ;
    coa:distinctValues "PARTIAL" ;
    coa:distinctValues "RECEIVED" ;
    rdfs:range xsd:string .

