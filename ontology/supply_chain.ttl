sc:Currency a owl:Class ;
    rdfs:label "Currency" ;
    rdfs:comment "Currency reference with approximate USD exchange rates" ;
    skos:altLabel "fx" ;
    skos:altLabel "currency code" ;
    skos:altLabel "DIM_CURRENCY" ;
    owl:hasKey ( sc:currency_currencyCode ) ;
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty sc:currency_currencyCode ; owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:currency_currencyName ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:currency_toUsdRate ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

sc:currency_currencyCode a owl:DatatypeProperty ;
    rdfs:label "CURRENCY_CODE" ;
    rdfs:comment "DIM_CURRENCY.CURRENCY_CODE" ;
    rdfs:domain sc:Currency ;
    coa:distinctValues "BRL" ;
    coa:distinctValues "CNY" ;
    coa:distinctValues "EUR" ;
    coa:distinctValues "GBP" ;
    coa:distinctValues "INR" ;
    coa:distinctValues "JPY" ;
    coa:distinctValues "KRW" ;
    coa:distinctValues "MXN" ;
    coa:distinctValues "MYR" ;
    coa:distinctValues "THB" ;
    coa:distinctValues "TWD" ;
    coa:distinctValues "USD" ;
    rdfs:range xsd:string .

sc:currency_currencyName a owl:DatatypeProperty ;
    rdfs:label "CURRENCY_NAME" ;
    rdfs:comment "DIM_CURRENCY.CURRENCY_NAME" ;
    rdfs:domain sc:Currency ;
    rdfs:range xsd:string .

sc:currency_toUsdRate a owl:DatatypeProperty ;
    rdfs:label "TO_USD_RATE" ;
    rdfs:comment "Approximate fixed rate for demo" ;
    rdfs:domain sc:Currency ;
    rdfs:range xsd:decimal .

