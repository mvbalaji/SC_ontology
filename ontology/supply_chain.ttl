        [ a owl:Restriction ; owl:onProperty sc:purchaseorderline_unitPrice ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty sc:purchaseorderline_promiseDate ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

