# Copy to .env and fill in. .env is gitignored — never commit real values.

# ── Snowflake: the only data connection ────────────────────────────────────
# SNOWFLAKE_PAT is a programmatic access token (Snowflake's recommendation for
# headless service accounts). Rotate it here, never in code.
SNOWFLAKE_ACCOUNT=YOURORG-YOURACCOUNT
SNOWFLAKE_USER=YOUR_SERVICE_USER
SNOWFLAKE_PAT=
SNOWFLAKE_ROLE=SUPPLYCHAIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=SCS
SNOWFLAKE_SCHEMA=INVENTORY

# ── Cortex agent ───────────────────────────────────────────────────────────
# Tools are defined inline in app.py and sent with every request, so there is
# no stored AGENT object to deploy — only the account host is needed.
SNOWFLAKE_HOST=YOURORG-YOURACCOUNT.snowflakecomputing.com
CORTEX_AGENT_MODEL=claude-sonnet-4-6
SEMANTIC_VIEW=SCS.SEMANTIC.SV_SUPPLY_CHAIN_KG
SEARCH_SERVICE=SCS.SEMANTIC.SCM_DOCUMENT_SEARCH
KG_SCHEMA=SCS.KG

# ── Tuning ─────────────────────────────────────────────────────────────────
MAX_ROWS=200
SNOWFLAKE_QUERY_TIMEOUT=120
CORTEX_AGENT_TIMEOUT=300

# ── Optional: follow-up suggestions + answer-relevance judge ───────────────
# Both switch themselves off when unset; neither is on the answer path.
# AZURE_API_KEY=
# AZURE_ENDPOINT=
# AZURE_API_VERSION=
# AZURE_DEPLOYMENT=

PORT=8000
FLASK_DEBUG=0
